@page "/"
@using Microsoft.Extensions.Options
@using PaymentOps.Web.Security
@inject IUserContext CurrentUser
@inject IOptions<AccessOptions> Access

<PageTitle>Payment Ops Investigation Agent</PageTitle>

<h1>Payment Ops Investigation Agent</h1>

<p>
    An AI agent for investigating payment-operations questions: payout delays, settlement failures
    and processor issues.
</p>

<p>Only the project foundation is in place so far. The investigation experience will replace this page.</p>

<section aria-labelledby="access-heading">
    <h2 id="access-heading">Your access</h2>
    <dl>
        <dt>Roles</dt>
        <dd>@string.Join(", ", CurrentUser.Roles.Order(StringComparer.Ordinal))</dd>
        <dt>Restricted knowledge</dt>
        <dd>@(HasRestrictedAccess ? "Yes, through Risk and Compliance" : "No")</dd>
    </dl>
</section>

@code {
    private bool HasRestrictedAccess =>
        !string.IsNullOrEmpty(Access.Value.RestrictedGroupId) && CurrentUser.GroupIds.Contains(Access.Value.RestrictedGroupId);
}
