@page "/investigate"
@attribute [Authorize(Policy = AuthorizationPolicies.Investigate)]
@using PaymentOps.Web.Security
@implements IDisposable
@using PaymentOps.Agent.Contracts
@using PaymentOps.Web.Components.Investigation
@using PaymentOps.Web.Investigating
@inject InvestigationSession Session
@inject QuestionLimits Limits
@inject NavigationManager Navigation

<PageTitle>Investigate · Contoso Payments</PageTitle>

<h1 class="page-title">Investigate</h1>

@{
    // Read once per render: each read checks expiry against the clock.
    var current = Session.Current;
}

<div class="investigate-grid">
    <div class="investigate-side">
        <ConversationNotice Status="Session.Conversation" MaxQuestionLength="Limits.MaxQuestionLength" />
        <Composer @ref="_composer" Value="@Session.Draft" ValueChanged="OnDraftChanged" MaxLength="Limits.MaxQuestionLength"
                  Busy="Session.Busy" Deciding="Session.Deciding" CanSubmit="Session.CanStart(Session.Draft)"
                  Submit="InvestigateAsync" Cancel="Session.Cancel" StartNew="Session.StartNew" />
        <ConversationList Turns="Session.Questions" />
        @if (!Session.Busy && Session.Steps is { Count: > 0 } steps)
        {
            <MudPaper Class="panel" Elevation="0">
                <section aria-labelledby="timeline-heading">
                    <h2 id="timeline-heading" class="panel-title">Steps</h2>
                    <Timeline Events="steps"
                              Run="@(current is AssessmentResult.NotAssessed { Reason: NotAssessedReason.Cancelled } ? TimelineRun.Stopped : TimelineRun.Finished)" />
                </section>
            </MudPaper>
        }
    </div>

    <div class="investigate-main">
        @if (Session.Busy)
        {
            <RunningCard Question="@(Session.CurrentQuestion ?? string.Empty)" Steps="Session.Steps" />
        }
        else if (current is not null || Session.Notice is not null)
        {
            <MudPaper Class="panel" Elevation="0">
                <section aria-labelledby="result-heading">
                    <h2 id="result-heading" class="panel-title" tabindex="-1" @ref="_resultHeading">Result</h2>
                    @if (Session.Notice is { } notice)
                    {
                        @* Refused before it ran: the result below, and its ticket card, are still as they were. *@
                        <NotAssessedPanel Reason="notice.Reason" MaxQuestionLength="Limits.MaxQuestionLength"
                                          EditQuestion="() => EditAsync(notice.Question)" TryAgain="() => Session.StartAsync(notice.Question)"
                                          StartNew="Session.StartNew" SignIn="SignIn" />
                    }
                    @if (current is not null)
                    {
                        <p class="result-question">@Session.CurrentQuestion</p>
                    }
                    @if (current is AssessmentResult.NotAssessed notAssessed)
                    {
                        <NotAssessedPanel Reason="notAssessed.Reason" MaxQuestionLength="Limits.MaxQuestionLength"
                                          EditQuestion="() => EditAsync(Session.CurrentQuestion)" TryAgain="() => Session.StartAsync(Session.CurrentQuestion ?? string.Empty)"
                                          StartNew="Session.StartNew" SignIn="SignIn" />
                    }
                    else if (current is { } result)
                    {
                        <AssessmentView Result="result" Deciding="Session.Deciding" Approve="Session.ApproveAsync" Reject="RejectAsync" />
                        @if (Session.DecisionFailed)
                        {
                            <p class="notice notice-error" role="alert">The ticket couldn't be created right now. The proposal is still pending; please try again.</p>
                        }
                    }
                </section>
            </MudPaper>
        }
    </div>
</div>

@code {
    private ElementReference _resultHeading;
    private Composer? _composer;

    // Results already shown aren't focused again when the person comes back to the page.
    private int _focusedRuns;

    protected override void OnInitialized()
    {
        _focusedRuns = Session.Completed;
        Session.Changed += OnSessionChanged;
    }

    private void OnDraftChanged(string draft) => Session.Draft = draft;

    private Task InvestigateAsync() => Session.StartAsync(Session.Draft);

    // The question goes back into the box to be changed; nothing runs until the person asks again.
    private async Task EditAsync(string? question)
    {
        Session.Draft = question ?? string.Empty;
        if (_composer is not null)
        {
            await _composer.FocusAsync();
        }
    }

    // A full load goes through sign-in again; the circuit's own sign-in has ended.
    private void SignIn() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

    private Task RejectAsync((RejectionReason Reason, string? Note) rejection) => Session.RejectAsync(rejection.Reason, rejection.Note);

    // The session changes on the investigation's thread; the page re-renders on its own.
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session.Completed != _focusedRuns && (Session.Current is not null || Session.Notice is not null))
        {
            _focusedRuns = Session.Completed;
            await _resultHeading.FocusAsync();
        }
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
