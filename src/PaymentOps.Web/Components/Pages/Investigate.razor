@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using PaymentOps.Agent.Contracts
@using PaymentOps.Web.Components.Investigation
@inject IInvestigationService Investigation
@inject IUserContext CurrentUser
@inject QuestionLimits Limits

<PageTitle>Payment Ops Investigation Agent</PageTitle>

<h1>Investigate</h1>

<p>Questions in this conversation carry over as context until you start a new investigation or reload the page.</p>
<ConversationNotice Status="Investigation.Conversation" />

<form @onsubmit="InvestigateAsync">
    <label for="question">Question</label>
    <textarea id="question" @bind="_question" @bind:event="oninput" rows="3" maxlength="@Limits.MaxQuestionLength" disabled="@_busy"></textarea>
    <button type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_question) || Investigation.Conversation.Ended)">Investigate</button>
    @if (_busy)
    {
        <button type="button" @onclick="Cancel">Cancel</button>
    }
    else
    {
        <button type="button" @onclick="StartNew">New investigation</button>
    }
</form>

@if (_events.Count > 0)
{
    <section aria-labelledby="timeline-heading">
        <h2 id="timeline-heading">Steps</h2>
        <Timeline Events="_events" />
    </section>
}

@if (_result is not null)
{
    <section aria-labelledby="result-heading">
        <h2 id="result-heading" tabindex="-1" @ref="_resultHeading">Result</h2>
        @if (_result is AssessmentResult.NotAssessed notAssessed)
        {
            <p role="status">@NotAssessedText.For(notAssessed.Reason, Limits.MaxQuestionLength)</p>
        }
        else
        {
            <AssessmentView Result="_result" />
        }
    </section>
}

<section aria-labelledby="access-heading">
    <h2 id="access-heading">Your access</h2>
    <dl>
        <dt>Roles</dt>
        <dd>@string.Join(", ", CurrentUser.Roles.Order(StringComparer.Ordinal))</dd>
        <dt>Restricted knowledge</dt>
        <dd>@(CurrentUser.CanAccessRestrictedKnowledge ? "Yes, through Risk and Compliance" : "No")</dd>
    </dl>
</section>

@code {
    private readonly List<InvestigationProgress> _events = [];
    private string _question = string.Empty;
    private bool _busy;
    private bool _focusResult;
    private AssessmentResult? _result;
    private ElementReference _resultHeading;

    // Owned by the page, so closing the tab or leaving cancels the investigation.
    private CancellationTokenSource? _run;

    // The service applies its own timeouts; the page adds only the person's Cancel.
    private async Task InvestigateAsync()
    {
        // Re-checked here: a disabled button is only the visible half.
        if (_busy || string.IsNullOrWhiteSpace(_question) || Investigation.Conversation.Ended)
        {
            return;
        }

        _busy = true;
        _result = null;
        _events.Clear();
        _run = new CancellationTokenSource();
        try
        {
            _result = await Investigation.InvestigateAsync(_question, new PageProgress(this), _run.Token);
            _focusResult = true;
        }
        finally
        {
            _run.Dispose();
            _run = null;
            _busy = false;
        }
    }

    private void Cancel() => _run?.Cancel();

    private void StartNew()
    {
        if (_busy)
        {
            return;
        }

        Investigation.StartNew();
        _question = string.Empty;
        _result = null;
        _events.Clear();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusResult && _result is not null)
        {
            _focusResult = false;
            await _resultHeading.FocusAsync();
        }
    }

    public void Dispose()
    {
        _run?.Cancel();
        _run?.Dispose();
    }

    // Events arrive on the investigation's thread; each is applied and rendered on the page's own.
    private sealed class PageProgress(Investigate page) : IProgress<InvestigationProgress>
    {
        public void Report(InvestigationProgress value) => _ = page.InvokeAsync(() =>
        {
            page._events.Add(value);
            page.StateHasChanged();
        });
    }
}
