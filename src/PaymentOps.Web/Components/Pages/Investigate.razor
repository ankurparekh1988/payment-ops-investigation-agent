@page "/investigate"
@implements IDisposable
@using PaymentOps.Agent.Contracts
@using PaymentOps.Web.Components.Investigation
@using PaymentOps.Web.Investigating
@inject InvestigationSession Session
@inject QuestionLimits Limits

<PageTitle>Investigate · Contoso Payments</PageTitle>

<h1 class="page-title">Investigate</h1>

<div class="investigate-grid">
    <div class="investigate-side">
        <ConversationNotice Status="Session.Conversation" MaxQuestionLength="Limits.MaxQuestionLength" />
        <Composer Value="@Session.Draft" ValueChanged="OnDraftChanged" MaxLength="Limits.MaxQuestionLength"
                  Busy="Session.Busy" Deciding="Session.Deciding" CanSubmit="Session.CanStart(Session.Draft)"
                  Submit="InvestigateAsync" Cancel="Session.Cancel" StartNew="Session.StartNew" />
        <ConversationList Turns="Session.Questions" />
        @if (!Session.Busy && Session.Steps is { Count: > 0 } steps)
        {
            <MudPaper Class="panel" Elevation="0">
                <section aria-labelledby="timeline-heading">
                    <h2 id="timeline-heading" class="panel-title">Steps</h2>
                    <Timeline Events="steps" />
                </section>
            </MudPaper>
        }
    </div>

    <div class="investigate-main">
        @if (Session.Busy)
        {
            <RunningCard Question="@(Session.CurrentQuestion ?? string.Empty)" Steps="Session.Steps" />
        }
        else if (Session.Current is { } result)
        {
            <MudPaper Class="panel" Elevation="0">
                <section aria-labelledby="result-heading">
                    <h2 id="result-heading" class="panel-title" tabindex="-1" @ref="_resultHeading">Result</h2>
                    <p class="result-question">@Session.CurrentQuestion</p>
                    @if (result is AssessmentResult.NotAssessed notAssessed)
                    {
                        <p role="status">@NotAssessedText.For(notAssessed.Reason, Limits.MaxQuestionLength)</p>
                    }
                    else
                    {
                        <AssessmentView Result="result" Deciding="Session.Deciding" Approve="Session.ApproveAsync" Reject="RejectAsync" />
                        @if (Session.DecisionFailed)
                        {
                            <p role="alert">The ticket couldn't be created right now. The proposal is still pending; please try again.</p>
                        }
                    }
                </section>
            </MudPaper>
        }
    </div>
</div>

@code {
    private ElementReference _resultHeading;

    // Results already shown aren't focused again when the person comes back to the page.
    private int _focusedRuns;

    protected override void OnInitialized()
    {
        _focusedRuns = Session.Completed;
        Session.Changed += OnSessionChanged;
    }

    private void OnDraftChanged(string draft) => Session.Draft = draft;

    private Task InvestigateAsync() => Session.StartAsync(Session.Draft);

    private Task RejectAsync((RejectionReason Reason, string? Note) rejection) => Session.RejectAsync(rejection.Reason, rejection.Note);

    // The session changes on the investigation's thread; the page re-renders on its own.
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session.Completed != _focusedRuns && Session.Current is not null)
        {
            _focusedRuns = Session.Completed;
            await _resultHeading.FocusAsync();
        }
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
