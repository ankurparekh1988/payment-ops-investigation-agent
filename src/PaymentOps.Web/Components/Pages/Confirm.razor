@page "/account/confirm"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@using PaymentOps.Web.Security
@inject IRecentAuthentication Recent
@inject NavigationManager Navigation

<PageTitle>Confirm it's you · Contoso Payments</PageTitle>

@* The sign-in window's first page. A form post, not a link, so no other site can start a step-up for this session. *@
<StatusCard Title="Confirm it's you">
    @if (SignInFlow.IsFlow(Flow))
    {
        <form id="confirm-form" method="post" action="/account/reauthenticate">
            <AntiforgeryToken />
            <input type="hidden" name="flow" value="@Flow" />
            <p class="status-text">Taking you to company sign-in.</p>
            <noscript>
                <button type="submit" class="status-action">Continue to sign-in</button>
            </noscript>
        </form>
        <script src="@Assets["js/confirm.js"]"></script>
    }
    else
    {
        <p class="status-text">This sign-in window can't be used. Close it and try again.</p>
    }
</StatusCard>

@code {
    [SupplyParameterFromQuery]
    public string? Flow { get; set; }

    // Anonymous so that an ended session is reported to the page that opened this window, not sent to sign-in.
    protected override void OnInitialized()
    {
        if (!Recent.Status.IsLive)
        {
            Navigation.NavigateTo(SignInFlow.ConfirmResultUrl(Flow, SignInFlow.StepUpResults.Ended));
        }
    }
}
