@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error · Calderbrook Payments</PageTitle>

<StatusCard Title="Something went wrong">
    <p class="status-text">Please try again. If it keeps happening, give your administrator this reference.</p>
    @if (!string.IsNullOrEmpty(RequestId))
    {
        <p class="status-footer"><span>Reference</span> <code class="status-reference">@RequestId</code></p>
    }
    <a href="/" class="status-action">Go to Home</a>
</StatusCard>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The trace id ties what the person sees to the request's telemetry; it carries nothing about them.
    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
