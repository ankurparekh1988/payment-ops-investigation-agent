@page "/access-denied"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@inject IUserContext CurrentUser

<PageTitle>No access · Calderbrook Payments</PageTitle>

<StatusCard Title="You don't have access to Payment Operations">
    <p class="status-text">Ask your administrator to assign you a role.</p>
    @if (CurrentUser.IsAuthenticated)
    {
        <div class="status-footer">
            <span>Signed in as @CurrentUser.DisplayName</span>
            <form method="post" action="account/sign-out">
                <AntiforgeryToken />
                <button type="submit" class="link-button">Sign out</button>
            </form>
        </div>
    }
</StatusCard>
