@using PaymentOps.Agent.Contracts

@* A report: what it came to, how sure, then the support. Model-written text is bound as text, never as markup. *@
@if (Result is AssessmentResult.Assessed assessed)
{
    <article class="result">
        <div class="result-meta">
            <span class="chip chip-@OutcomeTone(assessed.Outcome)">@OutcomeWord(assessed.Outcome)</span>
            @if (assessed.Outcome != AssessmentOutcome.Refused)
            {
                <span class="chip chip-neutral">@ConfidenceWord(assessed.Confidence) confidence</span>
            }
            <span class="result-id">Investigation @assessed.InvestigationId</span>
        </div>

        @if (assessed.Outcome == AssessmentOutcome.Incomplete)
        {
            <p class="notice notice-warning" role="note">Incomplete: the investigation couldn't check everything it needed, so this is a partial view.</p>
        }
        else if (assessed.Outcome == AssessmentOutcome.Escalated)
        {
            <p class="notice notice-info" role="note">Escalated: this needs an Operations Engineer to look into it.</p>
        }

        <h3 class="result-summary">@assessed.Summary.Text</h3>

        @if (assessed.Outcome != AssessmentOutcome.Refused)
        {
            <EvidenceChips Statement="assessed.Summary" />

            @if (assessed.RootCause is { } root)
            {
                <section class="result-section">
                    <h4 class="section-title">Root cause <span class="chip chip-neutral">@root.Label</span></h4>
                    <p>@root.Statement.Text</p>
                    <EvidenceChips Statement="root.Statement" />
                </section>
            }

            @if (assessed.Claims.Count > 0)
            {
                <section class="result-section">
                    <h4 class="section-title">What the evidence shows</h4>
                    <ul class="statement-list">
                        @foreach (var claim in assessed.Claims)
                        {
                            <li>@claim.Text <EvidenceChips Statement="claim" /></li>
                        }
                    </ul>
                </section>
            }

            @if (assessed.Gaps.Count > 0)
            {
                <section class="result-section">
                    <h4 class="section-title">Not checked</h4>
                    <ul class="statement-list gaps">
                        @foreach (var gap in assessed.Gaps)
                        {
                            <li>@gap</li>
                        }
                    </ul>
                </section>
            }

            @if (assessed.NextSteps.Count > 0)
            {
                <section class="result-section">
                    <h4 class="section-title">Next steps</h4>
                    <ul class="statement-list">
                        @foreach (var step in assessed.NextSteps)
                        {
                            <li>@step.Text <EvidenceChips Statement="step" /></li>
                        }
                    </ul>
                </section>
            }

            @if (assessed.Proposal is { } proposal)
            {
                <TicketCard Proposal="proposal" Deciding="Deciding" Approve="Approve" Reject="Reject" />
            }
            else if (assessed.ProposalWithheld)
            {
                <p class="notice notice-neutral" role="note">A ticket was proposed but isn't shown, because the investigation is incomplete.</p>
            }
        }
    </article>
}

@code {
    [Parameter, EditorRequired]
    public AssessmentResult Result { get; set; } = default!;

    [Parameter]
    public bool Deciding { get; set; }

    [Parameter]
    public EventCallback Approve { get; set; }

    [Parameter]
    public EventCallback<(RejectionReason Reason, string? Note)> Reject { get; set; }

    private static string OutcomeWord(AssessmentOutcome outcome) => outcome switch
    {
        AssessmentOutcome.Assessed => "Assessed",
        AssessmentOutcome.Incomplete => "Incomplete",
        AssessmentOutcome.Escalated => "Escalated",
        _ => "Refused",
    };

    private static string OutcomeTone(AssessmentOutcome outcome) => outcome switch
    {
        AssessmentOutcome.Assessed => "success",
        AssessmentOutcome.Incomplete => "warning",
        AssessmentOutcome.Escalated => "info",
        _ => "neutral",
    };

    private static string ConfidenceWord(Confidence confidence) => confidence switch
    {
        Confidence.High => "High",
        Confidence.Medium => "Medium",
        _ => "Low",
    };
}
