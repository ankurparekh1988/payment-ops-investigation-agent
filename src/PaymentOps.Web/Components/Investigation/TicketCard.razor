@using PaymentOps.Agent.Contracts

@* The proposal as the server stored it. Only its owning Engineer ever sees it pending; the server checks again on
   every decision. Model-written title and summary are bound as text. *@
<section class="ticket-card" aria-labelledby="ticket-heading">
    <h3 id="ticket-heading">Proposed incident ticket</h3>
    <p class="ticket-title">@Proposal.Title</p>
    <p>@Proposal.Summary</p>
    <dl>
        <dt>Processor</dt>
        <dd>@Proposal.ProcessorId@(Proposal.ProcessorReference is { } reference ? $" (their reference {reference})" : string.Empty)</dd>
        <dt>Merchants</dt>
        <dd>@string.Join(", ", Proposal.MerchantIds)</dd>
        <dt>Settlement dates</dt>
        <dd>@Dates()</dd>
    </dl>
    <EvidenceChips Statement="new Statement(string.Empty, Proposal.Evidence, Proposal.Citations)" />

    @switch (Proposal.Status)
    {
        case ProposalStatus.Draft:
            <p role="note">Draft prepared. An Operations Engineer must run their own investigation before a ticket can be created.</p>
            break;
        case ProposalStatus.Pending:
            <p>Can be approved until @Proposal.ExpiresAt?.UtcDateTime.ToString("HH:mm", CultureInfo.InvariantCulture) UTC. Approving creates the ticket as shown.</p>
            <label for="reject-reason">Reason to reject</label>
            <select id="reject-reason" @bind="_reason" disabled="@Deciding">
                @foreach (var reason in Enum.GetValues<RejectionReason>())
                {
                    <option value="@reason">@RejectionReasons.Describe(reason)</option>
                }
            </select>
            <label for="reject-note">Note (optional)</label>
            <textarea id="reject-note" @bind="_note" maxlength="500" rows="2" disabled="@Deciding"></textarea>
            <button type="button" @onclick="Approve" disabled="@Deciding">Approve</button>
            <button type="button" @onclick="RejectAsync" disabled="@Deciding">Reject</button>
            break;
        case ProposalStatus.Approved:
            <p role="status">Ticket @Proposal.TicketId created.</p>
            break;
        case ProposalStatus.Rejected:
            <p role="status">Rejected@(Proposal.Rejection is { } why ? $": {RejectionReasons.Describe(why)}" : string.Empty).</p>
            break;
        case ProposalStatus.Unavailable:
            <p role="note">This proposal can't be approved right now. Run the investigation again later to propose it again.</p>
            break;
        case ProposalStatus.Expired:
            <p role="note">This proposal expired before it was approved. Run the investigation again to propose it again.</p>
            break;
        case ProposalStatus.Superseded:
            <p role="note">This proposal was replaced by a later proposal in this conversation.</p>
            break;
    }
</section>

@code {
    private RejectionReason _reason = RejectionReason.EvidenceDoesNotSupportIt;
    private string? _note;

    [Parameter, EditorRequired]
    public TicketProposal Proposal { get; set; } = default!;

    [Parameter]
    public bool Deciding { get; set; }

    [Parameter]
    public EventCallback Approve { get; set; }

    [Parameter]
    public EventCallback<(RejectionReason Reason, string? Note)> Reject { get; set; }

    private Task RejectAsync() => Reject.InvokeAsync((_reason, _note));

    private string Dates() => Proposal.StartDate == Proposal.EndDate
        ? Proposal.StartDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
        : $"{Proposal.StartDate.ToString("d MMM", CultureInfo.InvariantCulture)} to {Proposal.EndDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)}";
}
