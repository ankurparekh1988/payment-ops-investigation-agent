@using PaymentOps.Agent.Contracts
@using PaymentOps.Web.Investigating

@* This tab's questions with what each came to. Questions are the person's own text, bound as text. *@
@if (Turns.Count > 0)
{
    <MudPaper Class="panel" Elevation="0">
        <h2 class="panel-title">This conversation</h2>
        <ol class="conversation-list">
            @foreach (var turn in Turns)
            {
                <li>
                    <span class="conversation-question">@turn.Question</span>
                    <span class="conversation-outcome">@Outcome(turn.Result)</span>
                </li>
            }
        </ol>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SessionTurn> Turns { get; set; } = [];

    private static string Outcome(AssessmentResult result) => result switch
    {
        AssessmentResult.Assessed { Outcome: AssessmentOutcome.Refused } => "Refused",
        AssessmentResult.Assessed { Outcome: AssessmentOutcome.Incomplete } => "Incomplete",
        AssessmentResult.Assessed => "Assessed",
        // The conversation doesn't carry these into the next question, so the list doesn't pretend it does.
        AssessmentResult.NotAssessed { Reason: NotAssessedReason.Cancelled } => "Cancelled · not kept",
        AssessmentResult.NotAssessed { Reason: NotAssessedReason.InvalidQuestion or NotAssessedReason.NotAuthorized } => "Not assessed · not kept",
        _ => "Not assessed",
    };
}
