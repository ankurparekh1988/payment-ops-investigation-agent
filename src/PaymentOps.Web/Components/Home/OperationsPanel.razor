@using PaymentOps.Web.Home
@using PaymentOps.Web.Usage
@inject IPauseSwitch Switch
@inject IDialogService Dialogs

@* Admins only: the service builds this section for no one else, and the switch checks the role again on every change. *@
<HomePanel Title="Operations" AddedBy="Admins">
    <div class="ops-grid">
        <div class="ops-item">
            <p class="ops-label">Investigations</p>
            <p class="ops-value pause-status">
                @if (View.PausedByConfiguration)
                {
                    <span class="chip chip-warning">Paused by configuration</span>
                }
                else if (_pause is null)
                {
                    <span class="chip chip-warning">Unknown</span>
                }
                else if (_pause.Paused)
                {
                    <span class="chip chip-warning">Paused</span>
                }
                else
                {
                    <span class="chip chip-success">Running</span>
                }
            </p>
        </div>
        <div class="ops-item">
            <p class="ops-label">Used today, everyone</p>
            @if (View.TotalToday is { } total && View.TotalLimit > 0)
            {
                <p class="ops-value">@total of @View.TotalLimit</p>
                <MudProgressLinear Value="@Percent(total)" Color="Color.Primary" Class="ops-bar"
                                   aria-label="@($"{total} of {View.TotalLimit} investigations used today")" />
            }
            else
            {
                <p class="ops-value">Not available</p>
            }
        </div>
        <div class="ops-item">
            <p class="ops-label">Per person, each day</p>
            <p class="ops-value ops-per-person">@(View.PerUserLimit > 0 ? View.PerUserLimit.ToString(CultureInfo.InvariantCulture) : "Not set")</p>
        </div>
    </div>

    <div class="pause-control">
        @if (View.PausedByConfiguration)
        {
            <p class="row-meta">The deployment's settings pause investigations; that can only be changed by a deployment.</p>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="true">Resume investigations</MudButton>
        }
        else if (_pause is null)
        {
            <p class="row-meta">The pause can't be read right now, so new investigations are refused until it can.</p>
        }
        else
        {
            @if (_pause.ChangedAt is { } changedAt)
            {
                <p class="row-meta">
                    Last change: @(_pause.Paused ? "paused" : "resumed") by @(_pause.ChangedByName ?? "an Admin"),
                    @changedAt.UtcDateTime.ToString("d MMM HH:mm", CultureInfo.InvariantCulture) UTC@(_pause.Reason is { } reason ? $" · {reason}" : string.Empty)
                </p>
            }
            <MudButton @ref="_trigger" Variant="@(_pause.Paused ? Variant.Filled : Variant.Outlined)"
                       Color="@(_pause.Paused ? Color.Primary : Color.Warning)" Disabled="_changing" OnClick="ChangeAsync">
                @(_pause.Paused ? "Resume investigations" : "Pause investigations")
            </MudButton>
            @if (_confirming)
            {
                <ConfirmIdentity Action="resume investigations" Confirmed="OnConfirmed" />
            }
        }
        @if (_message is { } message)
        {
            <p class="notice @(_failed ? "notice-error" : "notice-info") pause-message" role="status">@message</p>
        }
    </div>

    @if (View.WorkbookUrl is not null || View.AlertsUrl is not null)
    {
        <p class="ops-links">
            @if (View.WorkbookUrl is { } workbook)
            {
                <a href="@workbook" target="_blank" rel="noopener noreferrer">Operations workbook</a>
            }
            @if (View.AlertsUrl is { } alerts)
            {
                <a href="@alerts" target="_blank" rel="noopener noreferrer">Alert rules</a>
            }
        </p>
    }
</HomePanel>

@code {
    private PauseState? _pause;
    private MudButton? _trigger;
    private bool _changing;
    private bool _confirming;
    private bool _failed;
    private string? _message;

    [Parameter, EditorRequired]
    public OperationsView View { get; set; } = default!;

    protected override void OnInitialized() => _pause = View.Pause;

    private async Task ChangeAsync()
    {
        if (_pause is null || _changing)
        {
            return;
        }

        var pausing = !_pause.Paused;
        var dialog = await Dialogs.ShowAsync<PauseDialog>(
            pausing ? "Pause all investigations?" : "Resume investigations?",
            new DialogParameters<PauseDialog> { { d => d.Pausing, pausing }, { d => d.MaxReasonLength, PauseSwitch.MaxReasonLength } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var answer = await dialog.Result;

        // MudBlazor returns focus to whatever last had it, which isn't always the button (a mouse click needn't focus
        // it), so focus goes back to the button that opened the dialog.
        if (_trigger is not null)
        {
            await _trigger.FocusAsync();
        }

        if (answer is null || answer.Canceled)
        {
            return;
        }

        _changing = true;
        StateHasChanged();
        try
        {
            var result = await Switch.SetAsync(pausing, answer.Data as string, CancellationToken.None);
            _confirming = result is PauseResult.ReauthenticationRequired;
            (_pause, _message, _failed) = result switch
            {
                PauseResult.Changed changed => (changed.State, changed.State.Paused ? "Investigations paused." : "Investigations resumed.", false),
                PauseResult.Conflict conflict => (conflict.Current, "Another Admin changed this first. It's shown as it is now.", false),
                PauseResult.NotAuthorized => (_pause, "Only Admins can pause or resume investigations.", true),
                PauseResult.ReauthenticationRequired => (_pause, null, false),
                _ => (_pause, "Couldn't change the pause. Try again.", true),
            };
        }
        finally
        {
            _changing = false;
        }
    }

    // Nothing is retried: the person chooses the change again, now with a recent sign-in.
    private void OnConfirmed()
    {
        _confirming = false;
        (_message, _failed) = ("Confirmed. Choose Resume again.", false);
    }

    private double Percent(int total) => Math.Min(100, 100.0 * total / View.TotalLimit);
}
