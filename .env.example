# Copy this file to .env and fill in your own values. .env is ignored by git.
# Terraform reads TF_VAR_* variables directly; the azurerm provider reads ARM_*.

# Azure subscription and Entra tenant to deploy into (az account show).
ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=

# Region for every resource, for example canadacentral.
TF_VAR_location=

# Short lowercase prefix for resource names (3-12 letters or digits), for example paymentops.
TF_VAR_name_prefix=

# Environment to deploy, for example dev.
TF_VAR_environment=

# Your GitHub repository in owner/name form. Only its workflows can sign in to Azure.
TF_VAR_github_repository=

# Filled in by scripts/bootstrap.sh after the first run.
TF_STATE_RESOURCE_GROUP=
TF_STATE_STORAGE_ACCOUNT=
TF_STATE_CONTAINER=
