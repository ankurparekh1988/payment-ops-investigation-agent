# Copy this file to .env and fill in your own values. .env is ignored by git.
# Terraform reads TF_VAR_* variables directly; the azurerm provider reads ARM_*.

# Azure subscription and Entra tenant to deploy into (az account show).
ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=

# Region for every resource, for example canadacentral.
TF_VAR_location=

# Short lowercase prefix for resource names (3-12 letters or digits), for example paymentops.
TF_VAR_name_prefix=

# Environment to deploy, for example dev.
TF_VAR_environment=

# Your GitHub repository in owner/name form. Only its workflows can sign in to Azure.
TF_VAR_github_repository=

# Numeric owner and repository IDs. GitHub includes them in OIDC subjects for repositories
# created after 15 July 2026. Look them up with: gh api repos/OWNER/NAME --jq '.owner.id, .id'
TF_VAR_github_owner_id=
TF_VAR_github_repository_id=

# Entra object ID of the person who runs the bootstrap. Filled in by scripts/bootstrap.sh.
TF_VAR_bootstrap_operator_object_id=

# Optional: Entra object IDs (JSON list) of people who run the app locally against Azure,
# in single quotes, for example '["00000000-0000-0000-0000-000000000000"]'.
# Find yours: az ad signed-in-user show --query id
TF_VAR_developer_object_ids=

# --- Platform (recommended values for a low-cost dev environment in brackets) ---

# App Service plan tier [F1 = free; B1 adds always-on].
TF_VAR_app_service_sku=
# .NET runtime for the web app [10.0].
TF_VAR_dotnet_version=
# Knowledge storage redundancy [LRS].
TF_VAR_storage_replication_type=
# Telemetry retention in days [30] and daily ingestion cap in GB [0.5].
TF_VAR_log_retention_days=
TF_VAR_log_daily_quota_gb=
# Monthly budget that triggers alert emails, in the billing currency [10].
TF_VAR_monthly_budget=
# Where budget and operational alerts go.
TF_VAR_alert_email=
# Refuse to deploy a model that retires within this many days [90].
TF_VAR_model_retirement_buffer_days=

# Filled in by scripts/bootstrap.sh after the first run.
TF_STATE_RESOURCE_GROUP=
TF_STATE_STORAGE_ACCOUNT=
TF_STATE_CONTAINER=
