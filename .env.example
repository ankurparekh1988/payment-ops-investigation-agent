# Configuration for an environment deployed by the GitHub pipeline. For one you deploy from your
# own machine, with no GitHub, start from .env.local.example instead (see SETUP.md).
# Copy this file to .env and fill in your own values. .env is ignored by git.
# Terraform reads TF_VAR_* variables directly; the azurerm provider reads ARM_*.

# Azure subscription and Entra tenant to deploy into (az account show).
ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=

# Region for every resource, for example canadacentral.
TF_VAR_location=

# Short lowercase prefix for resource names (3-12 letters or digits), for example paymentops.
TF_VAR_name_prefix=

# Environment to deploy, for example dev.
TF_VAR_environment=

# Your GitHub repository in owner/name form. Only its workflows can sign in to Azure.
# Leave these three empty only with PAYMENTOPS_DEPLOY_FROM=local, for a workstation-only environment.
TF_VAR_github_repository=

# Numeric owner and repository IDs. GitHub includes them in OIDC subjects for repositories
# created after 15 July 2026. Look them up with: gh api repos/OWNER/NAME --jq '.owner.id, .id'
TF_VAR_github_owner_id=
TF_VAR_github_repository_id=

# Entra object ID of the person who runs the bootstrap. Filled in by scripts/bootstrap.sh.
TF_VAR_bootstrap_operator_object_id=

# Optional: Entra object IDs (JSON list) of people who run the app locally against Azure,
# in single quotes, for example '["00000000-0000-0000-0000-000000000000"]'.
# Find yours: az ad signed-in-user show --query id
TF_VAR_developer_object_ids=

# --- Evaluation identities (set after the platform exists, then re-run scripts/bootstrap.sh) ---

# From scripts/terraform.sh platform output: foundry_account_id, search_service_id and evaluation_dcr_id.
# The evaluation index's name is read from ai/manifest.yaml.
TF_VAR_eval_foundry_account_id=
TF_VAR_eval_search_service_id=
TF_VAR_eval_dcr_id=

# --- Platform (recommended values for a low-cost dev environment in brackets) ---

# App Service plan tier [F1 = free; B1 adds always-on].
TF_VAR_app_service_sku=
# .NET runtime for the web app [10.0].
TF_VAR_dotnet_version=
# Knowledge storage redundancy [LRS].
TF_VAR_storage_replication_type=
# Search service tier [free].
TF_VAR_search_sku=
# Telemetry retention in days [30] and daily ingestion cap in GB [0.5].
TF_VAR_log_retention_days=
TF_VAR_log_daily_quota_gb=
# Monthly budget that triggers alert emails, in the billing currency [10].
TF_VAR_monthly_budget=
# Where budget and operational alerts go.
TF_VAR_alert_email=
# Refuse to deploy a model that retires within this many days [90].
TF_VAR_model_retirement_buffer_days=
# Optional. Investigations one person, and everyone together, may start in a UTC day [25, 150].
TF_VAR_daily_limit_per_user=
TF_VAR_daily_limit_total=
# Optional. Pause every investigation [false].
TF_VAR_investigations_paused=
# Optional. List prices for estimating each investigation's cost, as an HCL object; unset, no cost is estimated.
# {currency="CAD", content_safety_per_thousand_records=0, deployments={chat-blue={input_per_million=0, output_per_million=0}}}
TF_VAR_cost_estimate=
# Optional. Let the budget's 100% notification turn the AI account's network access off [false].
TF_VAR_budget_cutoff_enabled=
# Optional. Availability test locations, each billed per run ['["us-va-ash-azr"]'], and alert thresholds per 15 minutes [5, 10].
TF_VAR_availability_test_locations=
TF_VAR_http5xx_threshold=
TF_VAR_guardrail_block_threshold=

# --- Identity (scripts/identity.sh) ---

# Create one demo user per role, only to demonstrate role behaviour [false], and the addresses the
# app runs on locally, which also creates a short-lived local sign-in secret ['["https://localhost:7207"]'].
TF_VAR_create_demo_users=
TF_VAR_local_app_urls=
# Filled in by scripts/identity.sh.
TF_VAR_entra_client_id=
TF_VAR_restricted_group_id=

# Filled in by scripts/bootstrap.sh after the first run.
TF_STATE_RESOURCE_GROUP=
TF_STATE_STORAGE_ACCOUNT=
TF_STATE_CONTAINER=
TF_STATE_OPERATOR_CONTAINER=
