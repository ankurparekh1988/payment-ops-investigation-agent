# An environment you deploy from this machine, with no GitHub and no pipeline (see SETUP.md).
# Copy to .env, fill in the three values, then run scripts/setup-local.sh. It fills in the rest.

# Deploy from this machine. Leave as is.
PAYMENTOPS_DEPLOY_FROM=local

# Azure region for every resource, for example canadacentral. It needs quota for the models in ai/manifest.yaml.
TF_VAR_location=

# Short lowercase prefix for resource names: 3-12 letters or digits, starting with a letter.
TF_VAR_name_prefix=

# Where budget and operational alerts go.
TF_VAR_alert_email=

# Optional: true creates one demo user per role (Reader, Engineer, Admin) to try role behaviour.
TF_VAR_create_demo_users=
